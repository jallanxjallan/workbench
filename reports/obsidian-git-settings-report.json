{
  "plugin": {
    "id": "obsidian-git",
    "name": "Git",
    "installed_version": "2.37.1",
    "manifest_path": "assets/plugins/obsidian-git/manifest.json",
    "report_generated_utc": "2026-03-01T03:37:11Z"
  },
  "scope": {
    "defaults_source": "src/constants.ts: DEFAULT_SETTINGS",
    "alternatives_source": [
      "src/setting/settings.ts (dropdown options and UI constraints)",
      "src/types.ts (enum unions)",
      "src/editor/lineAuthor/model.ts (line-author union types)"
    ],
    "note": "refreshSourceControl default is platform-dependent in source (Platform.isDesktopApp)."
  },
  "defaults": {
    "commitMessage": "vault backup: {{date}}",
    "autoCommitMessage": "vault backup: {{date}}",
    "commitMessageScript": "",
    "commitDateFormat": "YYYY-MM-DD HH:mm:ss",
    "autoSaveInterval": 0,
    "autoPushInterval": 0,
    "autoPullInterval": 0,
    "autoPullOnBoot": false,
    "autoCommitOnlyStaged": false,
    "disablePush": false,
    "pullBeforePush": true,
    "disablePopups": false,
    "showErrorNotices": true,
    "disablePopupsForNoChanges": false,
    "listChangedFilesInMessageBody": false,
    "showStatusBar": true,
    "updateSubmodules": false,
    "syncMethod": "merge",
    "mergeStrategy": "none",
    "customMessageOnAutoBackup": false,
    "autoBackupAfterFileChange": false,
    "treeStructure": false,
    "refreshSourceControl": {
      "value": "Platform.isDesktopApp",
      "desktop_default": true,
      "mobile_default": false
    },
    "basePath": "",
    "differentIntervalCommitAndPush": false,
    "changedFilesInStatusBar": false,
    "showedMobileNotice": false,
    "refreshSourceControlTimer": 7000,
    "showBranchStatusBar": true,
    "setLastSaveToLastCommit": false,
    "submoduleRecurseCheckout": false,
    "gitDir": "",
    "showFileMenu": true,
    "authorInHistoryView": "hide",
    "dateInHistoryView": false,
    "diffStyle": "split",
    "hunks": {
      "showSigns": false,
      "hunkCommands": false,
      "statusBar": "disabled"
    },
    "lineAuthor": {
      "show": false,
      "followMovement": "inactive",
      "authorDisplay": "initials",
      "showCommitHash": false,
      "dateTimeFormatOptions": "date",
      "dateTimeFormatCustomString": "YYYY-MM-DD HH:mm",
      "dateTimeTimezone": "viewer-local",
      "coloringMaxAge": "1y",
      "colorNew": {
        "r": 255,
        "g": 150,
        "b": 150
      },
      "colorOld": {
        "r": 120,
        "g": 160,
        "b": 255
      },
      "textColorCss": "var(--text-muted)",
      "ignoreWhitespace": false,
      "gutterSpacingFallbackLength": 5
    }
  },
  "alternatives": {
    "boolean_settings": {
      "allowed_values": [
        true,
        false
      ],
      "examples": [
        "autoPullOnBoot",
        "disablePush",
        "showStatusBar",
        "showBranchStatusBar",
        "showFileMenu",
        "dateInHistoryView",
        "lineAuthor.show",
        "lineAuthor.showCommitHash",
        "lineAuthor.ignoreWhitespace"
      ]
    },
    "syncMethod": {
      "default": "merge",
      "allowed_values": [
        "merge",
        "rebase",
        "reset"
      ],
      "ui_labels": {
        "merge": "Merge",
        "rebase": "Rebase",
        "reset": "Other sync service (Only updates the HEAD without touching the working directory)"
      }
    },
    "mergeStrategy": {
      "default": "none",
      "allowed_values": [
        "none",
        "ours",
        "theirs"
      ],
      "ui_labels": {
        "none": "None (git default)",
        "ours": "Our changes",
        "theirs": "Their changes"
      }
    },
    "authorInHistoryView": {
      "default": "hide",
      "allowed_values": [
        "hide",
        "full",
        "initials"
      ],
      "ui_labels": {
        "hide": "Hide",
        "full": "Full",
        "initials": "Initials"
      }
    },
    "diffStyle": {
      "default": "split",
      "allowed_values": [
        "split",
        "git_unified"
      ],
      "ui_labels": {
        "split": "Split",
        "git_unified": "Unified"
      }
    },
    "hunks.statusBar": {
      "default": "disabled",
      "allowed_values": [
        "disabled",
        "colored",
        "monochrome"
      ],
      "ui_labels": {
        "disabled": "Disabled",
        "colored": "Colored",
        "monochrome": "Monochrome"
      }
    },
    "lineAuthor.followMovement": {
      "default": "inactive",
      "allowed_values": [
        "inactive",
        "same-commit",
        "all-commits"
      ],
      "ui_labels": {
        "inactive": "Do not follow (default)",
        "same-commit": "Follow within same commit",
        "all-commits": "Follow within all commits (maybe slow)"
      }
    },
    "lineAuthor.authorDisplay": {
      "default": "initials",
      "allowed_values": [
        "hide",
        "initials",
        "first name",
        "last name",
        "full"
      ],
      "ui_labels": {
        "hide": "Hide",
        "initials": "Initials (default)",
        "first name": "First name",
        "last name": "Last name",
        "full": "Full name"
      }
    },
    "lineAuthor.dateTimeFormatOptions": {
      "default": "date",
      "allowed_values": [
        "hide",
        "date",
        "datetime",
        "natural language",
        "custom"
      ],
      "ui_labels": {
        "hide": "Hide",
        "date": "Date (default)",
        "datetime": "Date and time",
        "natural language": "Natural language",
        "custom": "Custom"
      }
    },
    "lineAuthor.dateTimeTimezone": {
      "default": "viewer-local",
      "allowed_values": [
        "viewer-local",
        "author-local",
        "utc0000"
      ],
      "ui_labels": {
        "viewer-local": "My local (default)",
        "author-local": "Author's local",
        "utc0000": "UTC+0000/Z"
      }
    },
    "free_text_settings": {
      "examples": [
        "commitMessage",
        "autoCommitMessage",
        "commitMessageScript",
        "commitDateFormat",
        "basePath",
        "gitDir",
        "lineAuthor.dateTimeFormatCustomString",
        "lineAuthor.textColorCss"
      ],
      "placeholders_supported_in_commit_messages": [
        "{{date}}",
        "{{hostname}}",
        "{{numFiles}}",
        "{{files}}"
      ]
    }
  },
  "constraints_and_behavior": {
    "autoSaveInterval": {
      "type": "number",
      "minimum": 0,
      "disable_value": 0,
      "unit": "minutes"
    },
    "autoPushInterval": {
      "type": "number",
      "minimum": 0,
      "disable_value": 0,
      "unit": "minutes"
    },
    "autoPullInterval": {
      "type": "number",
      "minimum": 0,
      "disable_value": 0,
      "unit": "minutes"
    },
    "refreshSourceControlTimer": {
      "type": "integer",
      "default": 7000,
      "unit": "milliseconds",
      "ui_minimum": 500
    },
    "lineAuthor.coloringMaxAge": {
      "type": "string_duration",
      "parser": "moment.duration('P' + value.toUpperCase())",
      "minimum": "1d",
      "default": "1y"
    },
    "lineAuthor.colorNew_and_colorOld": {
      "accepted_input_formats": [
        "rgb(r,g,b)",
        "hsl(h,s,l)",
        "hex",
        "named CSS colors"
      ],
      "stored_format": "RGB object {r,g,b}"
    },
    "lineAuthor.dateTimeFormatCustomString": {
      "format_engine": "moment.format",
      "default": "YYYY-MM-DD HH:mm"
    }
  },
  "non_default_storage_backed_options": {
    "description": "Shown in the plugin settings UI but persisted outside DEFAULT_SETTINGS (local storage / git config).",
    "keys": [
      "hostname placeholder replacement",
      "git binary path",
      "additional environment variables",
      "additional PATH paths",
      "server username",
      "server password/token",
      "plugin disabled on this device",
      "git config user.name",
      "git config user.email"
    ]
  },
  "sources": [
    "https://raw.githubusercontent.com/Vinzent03/obsidian-git/2.37.1/src/constants.ts",
    "https://raw.githubusercontent.com/Vinzent03/obsidian-git/2.37.1/src/setting/settings.ts",
    "https://raw.githubusercontent.com/Vinzent03/obsidian-git/2.37.1/src/types.ts",
    "https://raw.githubusercontent.com/Vinzent03/obsidian-git/2.37.1/src/editor/lineAuthor/model.ts",
    "assets/plugins/obsidian-git/manifest.json"
  ]
}
