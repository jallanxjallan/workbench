# Python cache
__pycache__/
*.pyc

# Default policy: ignore new files unless they match allow-rules below.
*

# Keep this file tracked.
!.gitignore

# Top-level command entrypoints.
!/bin/
!/bin/*

# Keep command helper libraries tracked.
!/bin/_env/
!/bin/_env/**
!/bin/_lib/
!/bin/_lib/**

# Keep Python implementation modules tracked.
!/lib/
!/lib/**

# Optional script adapters.
!/adapters/
!/adapters/*.py
!/adapters/*.sh
!/adapters/*.zsh

# Local-only secrets tooling and docs.
bin/backup-secrets
backups/secrets_backup.py
backups/secrets_include.txt
docs/SECRETS_BACKUP.md
