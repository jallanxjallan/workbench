#!/usr/bin/env bash
set -euo pipefail

studio_root="${1:-$HOME/Studio}"
assets_dir="$studio_root/Assets"
obsidian_dir="$studio_root/Obsidian"

if [[ -d "$assets_dir" && ! -e "$obsidian_dir" ]]; then
  mv "$assets_dir" "$obsidian_dir"
fi

if [[ ! -d "$obsidian_dir" ]]; then
  echo "ERROR: expected directory not found: $obsidian_dir" >&2
  exit 1
fi

rename_dir_if_present() {
  local from="$1"
  local to="$2"
  if [[ -d "$from" && ! -e "$to" ]]; then
    mv "$from" "$to"
  fi
}

rename_dir_if_present "$obsidian_dir/vault-template" "$obsidian_dir/vault"
rename_dir_if_present "$obsidian_dir/vault_template" "$obsidian_dir/vault"
rename_dir_if_present "$obsidian_dir/obsidian-common" "$obsidian_dir/common"
rename_dir_if_present "$obsidian_dir/obsidian_common" "$obsidian_dir/common"

if [[ ! -d "$obsidian_dir/vault" ]]; then
  echo "ERROR: expected vault template directory not found: $obsidian_dir/vault" >&2
  exit 1
fi

if [[ ! -d "$obsidian_dir/common" ]]; then
  echo "ERROR: expected common directory not found: $obsidian_dir/common" >&2
  exit 1
fi

echo "Migration complete:"
echo "  $obsidian_dir/vault"
echo "  $obsidian_dir/common"
