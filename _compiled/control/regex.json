{
  "regex": [
    {
      "name": "external_links",
      "pattern": "(https?://[^\\s\\)]+|file://[^\\s\\)]+)",
      "engine": "default",
      "ignore_case": true,
      "version": 1
    },
    {
      "name": "image_links",
      "pattern": "(!\\[[^\\]]*\\]\\([^\\)]+\\.(png|jpg|jpeg|webp|gif)\\))",
      "engine": "default",
      "ignore_case": false,
      "version": 1
    },
    {
      "name": "slug_field",
      "pattern": "(slug:\\s*[a-z0-9._-]+)",
      "engine": "default",
      "ignore_case": false,
      "version": 1
    },
    {
      "name": "slug_placeholder",
      "pattern": "(slug:\\s*__SLUG__)",
      "engine": "default",
      "ignore_case": false,
      "version": 1
    }
  ]
}
